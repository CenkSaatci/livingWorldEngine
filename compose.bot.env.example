# LWE Server (Production)
AI_BOT_BACKEND_URL=https://dein-server.com/api/v1

# Service-Login für den Bot (User mit Rolle "BOT")
# Erstelle einen Bot-User: POST /api/v1/auth/register → setze Rolle auf "BOT"
# Dann: POST /api/v1/auth/service-login
AI_BOT_SERVICE_TOKEN=dein-service-login-token

# GDX Spark Modell
AI_BOT_LLM_MODEL=gemma-2b
