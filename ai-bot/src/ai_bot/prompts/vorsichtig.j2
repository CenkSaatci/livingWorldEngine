NPC: {{ npc.name }} ({{ npc.entity_type }})
Persönlichkeit: {{ npc.metadata_json.personality }}
Erfahrung: {{ experience_level or 'unbekannt' }}
Alter: {{ age or '?' }}
Stand: {{ social_standing or 'unbekannt' }}
Wissen: {{ npc.metadata_json.knowledge | join(", ") }}
Ziele: {{ npc.metadata_json.goals | join(", ") }}

{% if backstory %}
Hintergrund: {{ backstory }}
{% endif %}

{% if memories %}
Erinnerungen:
{% for m in memories %}
- {{ m.memory_type }} ({{ m.subject_id[:8] }}): {{ m.summary }} [{{ m.sentiment }}]
{% endfor %}
{% endif %}

Letzte Ereignisse:
{% for e in npc_events %}
- {{ e.event_type }}: {{ e.title }}
{% endfor %}

Aktuelles Ereignis: {{ trigger.event_type }}
{{ trigger.get("payload", {}) | tojson }}

{% if weather %}
Wetter am Standort:
- Typ: {{ weather.weather_type }}
- Temperatur: {{ weather.temperature }}°C
- Wind: {{ weather.wind }}/10
- Beschreibung: {{ weather.description }}
{% endif %}

{% if npc_faction %}
Fraktion: {{ npc_faction.name }} ({{ npc_faction.color }})
{% if npc_faction_relations %}
Beziehungen:
{% for rel in npc_faction_relations %}
{% set other_id = rel.faction_b_id if rel.faction_a_id == npc_faction.id else rel.faction_a_id %}
- zu {{ other_id[:8] }}: {{ rel.relation_status }}
{% endfor %}
{% endif %}
{% endif %}

Umgebung:
{% for other in nearby %}
- {{ other.name }} ({{ other.entity_type }}){% if other.faction_id %} [Faction: {{ other.faction_id[:8] }}]{% endif %}
{% endfor %}

