# ============================================================
# Living World Engine — Environment Template
# ============================================================
# Kopiere diese Datei nach .env und fülle die Werte aus.
# .env wird von .gitignore ignoriert und darf NICHT committet werden.
# ============================================================

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=changeme
DB_NAME=lwe

# --- Spring Boot / Backend ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (Authentifizierung) ---
# Mindestens 32 Zeichen. In Produktion rotieren!
JWT_SECRET=please-generate-a-secure-random-secret-32chars
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Flyway ---
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_LOCATIONS=classpath:db/migration

# --- AI Bot (Phase 4) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_BOT_MODE=autonom
AI_BOT_POLL_INTERVAL_MS=2000

# --- Frontend (Phase 3, Vite) ---
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws

# --- Redis (Phase 5, optional in Phase 1) ---
REDIS_HOST=localhost
REDIS_PORT=6379